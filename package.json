{
  "name": "localleaf",
  "version": "0.1.0",
  "private": true,
  "description": "A local, Overleaf-style LaTeX editor: edit projects in the browser, compile with TeX Live (Docker) or a local TeX install, preview the PDF with SyncTeX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aalniak/localleaf.git"
  },
  "homepage": "https://github.com/aalniak/localleaf#readme",
  "bugs": {
    "url": "https://github.com/aalniak/localleaf/issues"
  },
  "keywords": [
    "latex",
    "overleaf",
    "editor",
    "texlive",
    "synctex",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build web",
    "start": "vite build web && node server/index.js",
    "serve": "node server/index.js",
    "import": "node scripts/import-zip.js",
    "test": "vitest run",
    "e2e": "node test/e2e/editor.e2e.js",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@vitest/coverage-v8": "^5.0.5",
    "codemirror": "^6.0.2",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
